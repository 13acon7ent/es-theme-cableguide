<?xml version="1.0" encoding="UTF-8"?>
<!--
Theme: es-theme-cableguide  (Batocera v44)
A 2010-era cable TV listings look for Batocera EmulationStation.

License: CC BY-NC-SA 4.0 (see LICENSE)

Credits:
- System photos (art/background/) and logos (art/logos/) from es-theme-carbon by Fabrice CARUSO,
  based on "Carbon" by Eric Hettervik (Rookervik) and "simple" by Nils Bonenberger,
  licensed CC-BY-NC-SA. Resized for this theme.
- Font: Roboto Condensed, SIL Open Font License 1.1 (fonts/OFL.txt).

Layout is designed at 1920x1080 (16:9). All coordinates are normalized (0-1).
-->
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>

  <variables>
    <!-- Edit these to recolor the theme (RRGGBB or RRGGBBAA) -->
    <cgHeader>1A3665</cgHeader>         <!-- header bar + column header bar -->
    <cgPanelTop>225485</cgPanelTop>     <!-- info panel gradient top -->
    <cgPanelBottom>7696C5</cgPanelBottom><!-- info panel gradient bottom -->
    <cgLine>40649E</cgLine>             <!-- separators in the header bar -->
    <cgChannel>92B8DD</cgChannel>       <!-- channel cells -->
    <cgChannelGap>05070C</cgChannelGap> <!-- black lines between channel cells -->
    <cgCellGap>959DA8</cgCellGap>       <!-- gray lines between program cells -->
    <cgCell>1A3665</cgCell>             <!-- default (navy) game cells -->
    <cgSports>0F703A</cgSports>         <!-- genre contains sports / fishing / hunting -->
    <cgPlatform>582D86</cgPlatform>     <!-- genre exactly "Platform" -->
    <cgAdventure>8BB1D6</cgAdventure>   <!-- genre contains "adventure" -->
    <cgHighlight>FDF3AC</cgHighlight>   <!-- selected row -->
    <cgMedia>05070C</cgMedia>           <!-- box art / system art panel -->
    <cgBanner>ECE8F7</cgBanner>         <!-- bottom help banner -->
    <cgBannerText>3B2A8C</cgBannerText>
    <cgBannerBorder>6F5BC4</cgBannerBorder>
    <cgText>FFFFFF</cgText>
    <cgTitle>F2EFA6</cgTitle>           <!-- yellow title text in the info panel -->
    <cgWordmark>B9BDC4</cgWordmark>     <!-- silver wordmark -->
    <cgDarkText>030F1D</cgDarkText>
    <cgShadow>000000B0</cgShadow>

    <!-- genre matching -->
    <!-- green if the genre CONTAINS any of these three words (any case) -->
    <cgSportsGenre>sports</cgSportsGenre>
    <cgSportsGenre2>fishing</cgSportsGenre2>
    <cgSportsGenre3>hunting</cgSportsGenre3>
    <cgPlatformGenre>Platform</cgPlatformGenre>  <!-- purple if the genre is EXACTLY this -->
    <cgAdventureGenre>adventure</cgAdventureGenre> <!-- light blue if the genre CONTAINS this (any case);
                                                        green and purple win if a genre matches both -->

    <!-- menu -->
    <cgMenuText>FFFFFF</cgMenuText>
    <cgMenuSoft>C3DBFF</cgMenuSoft>
    <cgMenuSelect>DFECB6</cgMenuSelect>

    <cgBold>./fonts/RobotoCondensed-Bold.ttf</cgBold>
    <cgMedium>./fonts/RobotoCondensed-Medium.ttf</cgMedium>
  </variables>

  <!-- ============================================================
       SCREEN (global overlay): clock in the header
       Shown only when "Show clock" is enabled in Batocera's UI settings.
       ============================================================ -->
  <view name="screen">
    <text name="clock">
      <pos>0.22 0.072</pos>
      <size>0.2 0.055</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.04</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor>
      <glowSize>1</glowSize>
      <glowOffset>2 2</glowOffset>
    </text>
  </view>

  <!-- ============================================================
       MENUS (Batocera's pop-up menu window)
       ============================================================ -->
  <view name="menu">
    <menuBackground name="menubg">
      <path>./art/menu_frame.png</path>
      <color>FFFFFFFF</color>
      <centerColor>FFFFFFFF</centerColor>
      <cornerSize>24 24</cornerSize>
      <scrollbarColor>${cgMenuSoft}90</scrollbarColor>
      <scrollbarCorner>0.49</scrollbarCorner>
      <scrollbarSize>0.004</scrollbarSize>
      <scrollbarAlignment>innerright</scrollbarAlignment>
    </menuBackground>
    <menuText name="menutitle">
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.04</fontSize>
      <color>${cgMenuText}</color>
    </menuText>
    <menuText name="menufooter">
      <fontPath>${cgMedium}</fontPath>
      <fontSize>0.022</fontSize>
      <color>${cgMenuSoft}</color>
    </menuText>
    <menuText name="menutext">
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.03</fontSize>
      <color>${cgMenuText}</color>
      <separatorColor>${cgMenuSoft}40</separatorColor>
      <selectorColor>${cgMenuSelect}</selectorColor>
      <selectedColor>${cgDarkText}</selectedColor>
    </menuText>
    <menuTextSmall name="menutextsmall">
      <fontPath>${cgMedium}</fontPath>
      <fontSize>0.02</fontSize>
      <color>${cgMenuSoft}</color>
    </menuTextSmall>
    <menuGroup name="menugroup">
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.022</fontSize>
      <color>${cgTitle}</color>
      <backgroundColor>00000000</backgroundColor>
      <lineSpacing>2</lineSpacing>
    </menuGroup>
    <menuGrid name="menugrid">
      <separatorColor>${cgMenuSoft}20</separatorColor>
    </menuGrid>
    <menuTextEdit name="menutextedit">
      <inactive>./art/textinput.png</inactive>
      <active>./art/textinput_active.png</active>
    </menuTextEdit>
    <menuButton name="menubutton">
      <path>./art/menu_button.png</path>
      <filledPath>./art/menu_button_filled.png</filledPath>
      <cornerSize>16 16</cornerSize>
    </menuButton>
  </view>

  <!-- ============================================================
       SHARED CHROME for system + gamelist views
       ============================================================ -->
  <view name="system, detailed">
    <image name="cgScreenBg" extra="true">
      <path>./art/white.png</path>
      <pos>0 0</pos><size>1 1</size>
      <color>${cgHeader}</color>
      <zIndex>1</zIndex>
    </image>

    <!-- Top-left info panel (gradient) + header bar -->
    <image name="cgPanelBg" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.1389</pos><size>0.5 0.3796</size>
      <color>${cgPanelTop}</color>
      <colorEnd>${cgPanelBottom}</colorEnd>
      <gradientType>vertical</gradientType>
      <zIndex>2</zIndex>
    </image>
    <image name="cgHeaderBg" extra="true">
      <path>./art/white.png</path>
      <pos>0 0</pos><size>0.5 0.1389</size>
      <color>${cgHeader}</color>
      <zIndex>3</zIndex>
    </image>
    <image name="cgHeaderRule" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.1361</pos><size>0.5 0.0028</size>
      <color>${cgLine}</color>
      <zIndex>4</zIndex>
    </image>
    <text name="cgWordmark" extra="true">
      <text>batocera</text>
      <pos>0.0365 0</pos><size>0.2 0.1389</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgMedium}</fontPath>
      <fontSize>0.07</fontSize>
      <color>${cgWordmark}</color>
      <zIndex>5</zIndex>
    </text>
    <!-- "GUIDE" badge -->
    <image name="cgPill" extra="true">
      <path>./art/white.png</path>
      <pos>0.4271 0.03</pos><size>0.0521 0.08</size>
      <color>${cgHighlight}</color>
      <roundCorners>8</roundCorners>
      <zIndex>5</zIndex>
    </image>
    <text name="cgPillText" extra="true">
      <text>GUIDE</text>
      <pos>0.4271 0.03</pos><size>0.0521 0.08</size>
      <alignment>center</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.0278</fontSize>
      <color>${cgDarkText}</color>
      <zIndex>6</zIndex>
    </text>

    <!-- Right media panel -->
    <image name="cgMediaBg" extra="true">
      <path>./art/white.png</path>
      <pos>0.5 0</pos><size>0.5 0.5185</size>
      <color>${cgMedia}</color>
      <zIndex>2</zIndex>
    </image>

    <!-- Column header bar -->
    <image name="cgBarBg" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.5185</pos><size>1 0.0621</size>
      <color>${cgHeader}</color>
      <zIndex>3</zIndex>
    </image>
    <image name="cgBarRuleTop" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.5185</pos><size>1 0.0028</size>
      <color>${cgChannelGap}</color>
      <zIndex>4</zIndex>
    </image>
    <image name="cgBarRuleBottom" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.5769</pos><size>1 0.0037</size>
      <color>${cgChannelGap}</color>
      <zIndex>4</zIndex>
    </image>
    <image name="cgBarRuleCol1" extra="true">
      <path>./art/white.png</path>
      <pos>0.1354 0.533</pos><size>0.0016 0.033</size>
      <color>${cgLine}</color>
      <zIndex>4</zIndex>
    </image>
    <image name="cgBarRuleCol2" extra="true">
      <path>./art/white.png</path>
      <pos>0.7552 0.533</pos><size>0.0016 0.033</size>
      <color>${cgLine}</color>
      <zIndex>4</zIndex>
    </image>

    <!-- Gap colors behind the grid: black under channel column, gray under program cells -->
    <image name="cgGridGapChan" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.5806</pos><size>0.1354 0.3666</size>
      <color>${cgChannelGap}</color>
      <zIndex>3</zIndex>
    </image>
    <image name="cgGridGapCells" extra="true">
      <path>./art/white.png</path>
      <pos>0.1354 0.5806</pos><size>0.8646 0.3666</size>
      <color>${cgCellGap}</color>
      <zIndex>3</zIndex>
    </image>

    <!-- Bottom help banner, full width -->
    <image name="cgBannerBorder" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.9472</pos><size>1 0.0528</size>
      <color>${cgBannerBorder}</color>
      <zIndex>3</zIndex>
    </image>
    <image name="cgBannerFill" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.95</pos><size>1 0.05</size>
      <color>${cgBanner}</color>
      <zIndex>4</zIndex>
    </image>
    <helpsystem name="help">
      <pos>0.0208 0.975</pos>
      <origin>0 0.5</origin>
      <textColor>${cgBannerText}FF</textColor>
      <iconColor>${cgBannerText}FF</iconColor>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.0296</fontSize>
    </helpsystem>
  </view>

  <!-- ============================================================
       SYSTEM VIEW
       ============================================================ -->
  <!-- System code text (channel cells, info panel, channel card) uses
       {system:theme}, except Batocera's "custom-collections" entry, shown as "custom".
       The expression is inlined: theme variables containing "=" are evaluated at load time. -->
  <view name="system">
    <image name="logo"><visible>false</visible></image>
    <text name="logoText"><visible>false</visible></text>
    <text name="systemInfo"><visible>false</visible></text>

    <text name="cgListingsLabel" extra="true">
      <text>System Listings</text>
      <pos>0.22 0.017</pos><size>0.2 0.055</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.04</fontSize>
      <color>${cgTitle}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>5</zIndex>
    </text>

    <!-- Info panel -->
    <text name="cgSysName" extra="true">
      <text>{system:fullName}</text>
      <pos>0.0365 0.155</pos><size>0.26 0.06</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.042</fontSize>
      <color>${cgTitle}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <singleLineScroll>true</singleLineScroll>
      <zIndex>10</zIndex>
    </text>
    <text name="cgSysChannel" extra="true">
      <text>{system:theme} == 'custom-collections' ? 'custom' : {system:theme}</text>
      <pos>0.30 0.155</pos><size>0.1792 0.06</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>true</forceUppercase>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.04</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>
    <text name="cgSysMaker" extra="true">
      <text>{system:manufacturer}  ·  {system:releaseYear}</text>
      <pos>0.0365 0.215</pos><size>0.44 0.05</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.038</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>
    <text name="cgSysStats" extra="true">
      <text>{system:total} games available</text>
      <pos>0.0365 0.27</pos><size>0.44 0.05</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.038</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>

    <!-- System art: a generated "channel card" (no images needed) -->
    <image name="cgCardBg" extra="true">
      <path>./art/white.png</path>
      <pos>0.5 0</pos><size>0.5 0.5185</size>
      <color>${cgHeader}</color>
      <colorEnd>${cgPanelTop}</colorEnd>
      <gradientType>vertical</gradientType>
      <zIndex>6</zIndex>
    </image>
    <text name="cgCardCount" extra="true">
      <text>{system:total} GAMES</text>
      <pos>0.5 0.06</pos><size>0.5 0.05</size>
      <alignment>center</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.034</fontSize>
      <color>${cgChannel}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>7</zIndex>
    </text>
    <text name="cgCardCode" extra="true">
      <text>{system:theme} == 'custom-collections' ? 'custom' : {system:theme}</text>
      <pos>0.5 0.12</pos><size>0.5 0.17</size>
      <alignment>center</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>true</forceUppercase>
      <multiLine>false</multiLine>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.13</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>2</glowSize><glowOffset>4 4</glowOffset>
      <zIndex>7</zIndex>
    </text>
    <text name="cgCardName" extra="true">
      <text>{system:fullName}</text>
      <pos>0.52 0.3</pos><size>0.46 0.07</size>
      <alignment>center</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.05</fontSize>
      <color>${cgTitle}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>7</zIndex>
    </text>
    <text name="cgCardMaker" extra="true">
      <text>{system:manufacturer}  ·  {system:releaseYear}</text>
      <pos>0.52 0.38</pos><size>0.46 0.06</size>
      <alignment>center</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.038</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>7</zIndex>
    </text>
    <!-- System photo (from es-theme-carbon) covers the card when one exists -->
    <image name="cgSysPhoto" extra="true">
      <path>./art/background/${system.theme}.jpg</path>
      <pos>0.75 0.2593</pos>
      <origin>0.5 0.5</origin>
      <size>0.5 0.5185</size>
      <linearSmooth>true</linearSmooth>
      <zIndex>8</zIndex>
    </image>
    <!-- Optional user image: art/systems/<system>.jpg overrides everything -->
    <image name="cgSysArt" extra="true">
      <path>./art/systems/${system.theme}.jpg</path>
      <pos>0.75 0.2593</pos>
      <origin>0.5 0.5</origin>
      <size>0.5 0.5185</size>
      <linearSmooth>true</linearSmooth>
      <zIndex>9</zIndex>
    </image>

    <!-- Column header -->
    <text name="cgBarLeft" extra="true">
      <text>Channels</text>
      <pos>0.0146 0.5185</pos><size>0.12 0.0621</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.036</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>
    <text name="cgBarMid" extra="true">
      <text>All Systems</text>
      <pos>0.1458 0.5185</pos><size>0.6 0.0621</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.036</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>
    <text name="cgBarRight" extra="true">
      <text>Manufacturer</text>
      <pos>0.7656 0.5185</pos><size>0.22 0.0621</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.036</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>

    <textlist name="textlist">
      <pos>0 0.5806</pos>
      <size>1 0.3666</size>
      <lines>5</lines>
      <selectorColor>00000000</selectorColor>
      <primaryColor>00000000</primaryColor>
      <secondaryColor>00000000</secondaryColor>
      <selectedColor>00000000</selectedColor>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.037</fontSize>
      <horizontalMargin>0</horizontalMargin>
      <scrollSound>./art/tick.wav</scrollSound>
      <zIndex>20</zIndex>
      <itemTemplate>
        <container>
          <pos>0 0</pos><size>1 1</size>
          <image name="chanCell">
            <path>${themePath}/art/white.png</path>
            <pos>0 0</pos><size>0.1333 0.95</size>
            <color>${cgChannel}</color>
          </image>
          <text name="chanText">
            <text>{system:theme} == 'custom-collections' ? 'custom' : {system:theme}</text>
            <pos>0 0</pos><size>0.1333 0.95</size>
            <alignment>center</alignment>
            <verticalAlignment>center</verticalAlignment>
            <forceUppercase>true</forceUppercase>
            <multiLine>false</multiLine>
            <fontPath>${themePath}/fonts/RobotoCondensed-Bold.ttf</fontPath>
            <fontSize>0.03</fontSize>
            <color>${cgDarkText}</color>
          </text>
          <image name="titleCell">
            <path>${themePath}/art/white.png</path>
            <pos>0.1354 0</pos><size>0.6193 0.95</size>
            <color>${cgCell}</color>
          </image>
          <image name="titleSel">
            <path>${themePath}/art/white.png</path>
            <pos>0.1354 0</pos><size>0.6193 0.95</size>
            <color>${cgHighlight}00</color>
            <storyboard event="activate">
              <animation property="color" to="${cgHighlight}FF"/>
            </storyboard>
            <storyboard event="deactivate">
              <animation property="color" to="${cgHighlight}00"/>
            </storyboard>
          </image>
          <text name="titleText">
            <text>{system:fullName}</text>
            <pos>0.1458 0</pos><size>0.6 0.95</size>
            <verticalAlignment>center</verticalAlignment>
            <multiLine>false</multiLine>
            <fontPath>${themePath}/fonts/RobotoCondensed-Bold.ttf</fontPath>
            <fontSize>0.038</fontSize>
            <color>${cgText}</color>
            <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
            <storyboard event="activate">
              <animation property="color" to="${cgDarkText}"/>
              <animation property="glowColor" to="00000000"/>
              <animation property="singleLineScroll" to="true"/>
            </storyboard>
            <storyboard event="deactivate">
              <animation property="color" to="${cgText}"/>
              <animation property="glowColor" to="${cgShadow}"/>
              <animation property="singleLineScroll" to="false"/>
            </storyboard>
          </text>
          <image name="sideCell">
            <path>${themePath}/art/white.png</path>
            <pos>0.7568 0</pos><size>0.2432 0.95</size>
            <color>${cgCell}</color>
          </image>
          <text name="sideText">
            <text>{system:manufacturer}</text>
            <pos>0.7672 0</pos><size>0.225 0.95</size>
            <verticalAlignment>center</verticalAlignment>
            <multiLine>false</multiLine>
            <fontPath>${themePath}/fonts/RobotoCondensed-Bold.ttf</fontPath>
            <fontSize>0.034</fontSize>
            <color>${cgText}</color>
            <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
          </text>
        </container>
      </itemTemplate>
    </textlist>
  </view>

  <!-- ============================================================
       GAMELIST VIEW (detailed)
       ============================================================ -->
  <view name="detailed">
    <!-- Header: system logo replaces the "batocera" wordmark.
         Batocera shows "logo" when one of its paths exists (the last existing path wins),
         otherwise it shows "logoText" with the system's full name. -->
    <text name="cgWordmark"><visible>false</visible></text>
    <image name="logo">
      <path>./art/logos/${system.theme}.png</path>
      <path>./art/logos/${system.theme}.svg</path>
      <pos>0.0365 0.0694</pos>
      <origin>0 0.5</origin>
      <maxSize>0.19 0.105</maxSize>
      <linearSmooth>true</linearSmooth>
      <visible>true</visible>
      <zIndex>5</zIndex>
    </image>
    <text name="logoText">
      <pos>0.0365 0</pos><size>0.19 0.1389</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.042</fontSize>
      <lineSpacing>1.0</lineSpacing>
      <color>${cgWordmark}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <visible>true</visible>
      <zIndex>5</zIndex>
    </text>
    <image name="md_image, md_thumbnail, md_marquee">
      <pos>2 2</pos><size>0 0</size>
      <visible>false</visible>
    </image>
    <text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_lastplayed, md_lbl_playcount, md_lbl_gametime, md_lbl_favorite, md_developer, md_publisher, md_playcount, md_gametime, md_favorite">
      <pos>2 2</pos><size>0 0</size>
      <visible>false</visible>
    </text>
    <datetime name="md_lastplayed">
      <pos>2 2</pos><size>0 0</size>
      <visible>false</visible>
    </datetime>

    <text name="cgListingsLabel" extra="true">
      <text>Game Listings</text>
      <pos>0.22 0.017</pos><size>0.2 0.055</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.04</fontSize>
      <color>${cgTitle}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>5</zIndex>
    </text>

    <!-- Info panel: selected game -->
    <text name="md_name">
      <pos>0.0365 0.155</pos><size>0.26 0.06</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.042</fontSize>
      <color>${cgTitle}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <singleLineScroll>true</singleLineScroll>
      <visible>true</visible>
      <zIndex>40</zIndex>
    </text>
    <text name="cgChannel" extra="true">
      <text>{system:theme} == 'custom-collections' ? 'custom' : {system:theme}</text>
      <pos>0.30 0.155</pos><size>0.1792 0.06</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
      <forceUppercase>true</forceUppercase>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.04</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>
    <datetime name="md_releasedate">
      <pos>0.0365 0.215</pos><size>0.05 0.05</size>
      <format>%Y</format>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.038</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>40</zIndex>
    </datetime>
    <text name="md_genre">
      <pos>0.09 0.215</pos><size>0.18 0.05</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.038</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>40</zIndex>
    </text>
    <text name="md_lbl_players">
      <pos>0.275 0.215</pos><size>0.085 0.05</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.038</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>40</zIndex>
    </text>
    <text name="md_players">
      <pos>0.36 0.215</pos><size>0.04 0.05</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.038</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>40</zIndex>
    </text>
    <rating name="md_rating">
      <pos>0.4792 0.24</pos>
      <origin>1 0.5</origin>
      <size>0.075 0.03</size>
      <horizontalAlignment>right</horizontalAlignment>
      <color>${cgText}</color>
      <unfilledColor>FFFFFF40</unfilledColor>
      <zIndex>40</zIndex>
    </rating>
    <text name="md_description">
      <pos>0.0365 0.27</pos><size>0.445 0.238</size>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.036</fontSize>
      <lineSpacing>1.15</lineSpacing>
      <autoScroll>vertical</autoScroll>
      <autoScrollDelay>4000</autoScrollDelay>
      <autoScrollSpeed>120</autoScrollSpeed>  <!-- ms per pixel; default 150 -->
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>40</zIndex>
    </text>

    <!-- Box art: box (thumbnail) first, then screenshot, then NO SIGNAL card -->
    <image name="cgBoxArt" extra="true">
      <path>exists({game:thumbnail}) ? {game:thumbnail} : {game:image}</path>
      <default>./art/nosignal.png</default>
      <pos>0.75 0.2593</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.46 0.48</maxSize>
      <linearSmooth>true</linearSmooth>
      <zIndex>8</zIndex>
    </image>

    <!-- Column header -->
    <text name="cgBarLeft" extra="true">
      <text>Year</text>
      <pos>0.0146 0.5185</pos><size>0.12 0.0621</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.036</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>
    <text name="cgBarMid" extra="true">
      <text>{system:fullName}</text>
      <pos>0.1458 0.5185</pos><size>0.6 0.0621</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.036</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>
    <text name="cgBarRight" extra="true">
      <text>Genre</text>
      <pos>0.7656 0.5185</pos><size>0.22 0.0621</size>
      <verticalAlignment>center</verticalAlignment>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.036</fontSize>
      <color>${cgText}</color>
      <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
      <zIndex>10</zIndex>
    </text>

    <!-- The channel grid: one row per game.
         Title and Genre cells are navy, light blue when the genre contains "adventure",
         green when it contains "sports", "fishing" or "hunting" (any case),
         or purple when it is exactly "Platform". Later layers win. Selected title cell turns yellow. -->
    <textlist name="gamelist">
      <pos>0 0.5806</pos>
      <size>1 0.3666</size>
      <lines>5</lines>
      <selectorColor>00000000</selectorColor>
      <primaryColor>00000000</primaryColor>
      <secondaryColor>00000000</secondaryColor>
      <selectedColor>00000000</selectedColor>
      <fontPath>${cgBold}</fontPath>
      <fontSize>0.037</fontSize>
      <horizontalMargin>0</horizontalMargin>
      <scrollSound>./art/tick.wav</scrollSound>
      <zIndex>20</zIndex>
      <itemTemplate>
        <container>
          <pos>0 0</pos><size>1 1</size>

          <!-- channel cell: release year over system code -->
          <image name="chanCell">
            <path>${themePath}/art/white.png</path>
            <pos>0 0</pos><size>0.1333 0.95</size>
            <color>${cgChannel}</color>
          </image>
          <text name="chanTop">
            <text>{game:releaseYear}</text>
            <pos>0 0.04</pos><size>0.1333 0.44</size>
            <alignment>center</alignment>
            <verticalAlignment>center</verticalAlignment>
            <fontPath>${themePath}/fonts/RobotoCondensed-Bold.ttf</fontPath>
            <fontSize>0.0315</fontSize>
            <color>${cgDarkText}</color>
          </text>
          <text name="chanBottom">
            <text>{system:theme} == 'custom-collections' ? 'custom' : {system:theme}</text>
            <pos>0 0.46</pos><size>0.1333 0.44</size>
            <alignment>center</alignment>
            <verticalAlignment>center</verticalAlignment>
            <forceUppercase>true</forceUppercase>
            <multiLine>false</multiLine>
            <fontPath>${themePath}/fonts/RobotoCondensed-Bold.ttf</fontPath>
            <fontSize>0.026</fontSize>
            <color>${cgDarkText}</color>
          </text>

          <!-- title cell: navy base, genre color layers, yellow selection layer -->
          <image name="titleCell">
            <path>${themePath}/art/white.png</path>
            <pos>0.1354 0</pos><size>0.6193 0.95</size>
            <color>${cgCell}</color>
          </image>
          <image name="titleAdventure">
            <path>${themePath}/art/white.png</path>
            <pos>0.1354 0</pos><size>0.6193 0.95</size>
            <color>${cgAdventure}</color>
            <visible>contains(lower({game:genre}), '${cgAdventureGenre}')</visible>
          </image>
          <image name="titleSports">
            <path>${themePath}/art/white.png</path>
            <pos>0.1354 0</pos><size>0.6193 0.95</size>
            <color>${cgSports}</color>
            <visible>contains(lower({game:genre}), '${cgSportsGenre}') || contains(lower({game:genre}), '${cgSportsGenre2}') || contains(lower({game:genre}), '${cgSportsGenre3}')</visible>
          </image>
          <image name="titlePlatform">
            <path>${themePath}/art/white.png</path>
            <pos>0.1354 0</pos><size>0.6193 0.95</size>
            <color>${cgPlatform}</color>
            <visible>{game:genre} == '${cgPlatformGenre}'</visible>
          </image>
          <image name="titleSel">
            <path>${themePath}/art/white.png</path>
            <pos>0.1354 0</pos><size>0.6193 0.95</size>
            <color>${cgHighlight}00</color>
            <storyboard event="activate">
              <animation property="color" to="${cgHighlight}FF"/>
            </storyboard>
            <storyboard event="deactivate">
              <animation property="color" to="${cgHighlight}00"/>
            </storyboard>
          </image>
          <text name="titleText">
            <text>{game:name}</text>
            <pos>0.1458 0</pos><size>0.6 0.95</size>
            <verticalAlignment>center</verticalAlignment>
            <multiLine>false</multiLine>
            <fontPath>${themePath}/fonts/RobotoCondensed-Bold.ttf</fontPath>
            <fontSize>0.038</fontSize>
            <color>${cgText}</color>
            <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
            <storyboard event="activate">
              <animation property="color" to="${cgDarkText}"/>
              <animation property="glowColor" to="00000000"/>
              <animation property="singleLineScroll" to="true"/>
            </storyboard>
            <storyboard event="deactivate">
              <animation property="color" to="${cgText}"/>
              <animation property="glowColor" to="${cgShadow}"/>
              <animation property="singleLineScroll" to="false"/>
            </storyboard>
          </text>

          <!-- genre cell: same color rule as the title cell -->
          <image name="sideCell">
            <path>${themePath}/art/white.png</path>
            <pos>0.7568 0</pos><size>0.2432 0.95</size>
            <color>${cgCell}</color>
          </image>
          <image name="sideAdventure">
            <path>${themePath}/art/white.png</path>
            <pos>0.7568 0</pos><size>0.2432 0.95</size>
            <color>${cgAdventure}</color>
            <visible>contains(lower({game:genre}), '${cgAdventureGenre}')</visible>
          </image>
          <image name="sideSports">
            <path>${themePath}/art/white.png</path>
            <pos>0.7568 0</pos><size>0.2432 0.95</size>
            <color>${cgSports}</color>
            <visible>contains(lower({game:genre}), '${cgSportsGenre}') || contains(lower({game:genre}), '${cgSportsGenre2}') || contains(lower({game:genre}), '${cgSportsGenre3}')</visible>
          </image>
          <image name="sidePlatform">
            <path>${themePath}/art/white.png</path>
            <pos>0.7568 0</pos><size>0.2432 0.95</size>
            <color>${cgPlatform}</color>
            <visible>{game:genre} == '${cgPlatformGenre}'</visible>
          </image>
          <text name="sideText">
            <text>{game:genre}</text>
            <pos>0.7672 0</pos><size>0.225 0.95</size>
            <verticalAlignment>center</verticalAlignment>
            <multiLine>false</multiLine>
            <fontPath>${themePath}/fonts/RobotoCondensed-Bold.ttf</fontPath>
            <fontSize>0.034</fontSize>
            <color>${cgText}</color>
            <glowColor>${cgShadow}</glowColor><glowSize>1</glowSize><glowOffset>2 2</glowOffset>
          </text>
        </container>
      </itemTemplate>
    </textlist>
  </view>

  <!-- ============================================================
       THEME OPTIONS (User Interface Settings > Theme Configuration)
       The first option in each subset is the default.
       Must stay after the base views: later definitions override earlier ones.
       ============================================================ -->
  <subset name="gamemedia" displayName="Game media">
    <include name="boxart" displayName="Box art">./subsets/media/boxart.xml</include>
    <include name="video" displayName="Video">./subsets/media/video.xml</include>
    <include name="screenshot" displayName="Screenshot">./subsets/media/screenshot.xml</include>
    <include name="titleshot" displayName="Title screen">./subsets/media/titleshot.xml</include>
    <include name="fanart" displayName="Fan art">./subsets/media/fanart.xml</include>
  </subset>
</theme>
