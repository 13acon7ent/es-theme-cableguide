<?xml version="1.0" encoding="UTF-8"?>
<!-- Preview style: logo (marquee), falls back to box art, then NO SIGNAL -->
<theme>
  <formatVersion>7</formatVersion>
  <view name="detailed">
    <image name="cgBoxArt">
      <path>exists({game:marquee}) ? {game:marquee} : {game:thumbnail}</path>
      <default>./../../art/nosignal.png</default>
      <visible>true</visible>
    </image>
  </view>
</theme>
