<?xml version="1.0" encoding="UTF-8"?>
<!-- Preview style: mix image, falls back to screenshot, then NO SIGNAL -->
<theme>
  <formatVersion>7</formatVersion>
  <view name="detailed">
    <image name="cgBoxArt">
      <path>exists({game:mix}) ? {game:mix} : {game:image}</path>
      <default>./../../art/nosignal.png</default>
      <visible>true</visible>
    </image>
  </view>
</theme>
